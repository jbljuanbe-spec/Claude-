  "lectura_parrafo": [
    {
      "id": "para_01",
      "texto": "私は毎日7時に起きます。朝ご飯を食べて、会社へ行きます。仕事は9時から始まります。私は会社員です。仕事はあまり難しくないですが、時々忙しいです。今日はあまり忙しくないので、早く帰ることができます。",
      "preguntas": [
        {
          "pregunta": "何時に起きますか。",
          "opciones": [
            "6時",
            "7時",
            "8時",
            "9時"
          ],
          "respuesta": "7時"
        },
        {
          "pregunta": "仕事は何時から始まりますか。",
          "opciones": [
            "7時",
            "8時",
            "9時",
            "10時"
          ],
          "respuesta": "9時"
        },
        {
          "pregunta": "今日はどうですか。",
          "opciones": [
            "とても忙しい",
            "あまり忙しくない",
            "休みです",
            "病気です"
          ],
          "respuesta": "あまり忙しくない"
        }
      ]
    },
    {
      "id": "para_02",
      "texto": "先週、家族と沖縄に旅行に行きました。海はとてもきれいでした。魚料理を食べたり、泳いだりしました。天気もよかったです。でも、旅行は短かったので、また行きたいです。",
      "preguntas": [
        {
          "pregunta": "どこに旅行に行きましたか。",
          "opciones": [
            "東京",
            "沖縄",
            "京都",
            "大阪"
          ],
          "respuesta": "沖縄"
        },
        {
          "pregunta": "海はどうでしたか。",
          "opciones": [
            "汚かった",
            "きれいだった",
            "寒かった",
            "小さかった"
          ],
          "respuesta": "きれいだった"
        },
        {
          "pregunta": "旅行はどうでしたか。",
          "opciones": [
            "長かった",
            "短かった",
            "高かった",
            "悪かった"
          ],
          "respuesta": "短かった"
        }
      ]
    },
    {
      "id": "para_03",
      "texto": "田中さんは私の友達です。田中さんは会社員で、毎日忙しいです。でも、週末はいつも映画を見たり、料理をしたりします。田中さんは日本語の先生になりたいと言っていました。私も日本語を勉強するのが好きなので、田中さんとよく話します。",
      "preguntas": [
        {
          "pregunta": "田中さんの仕事は何ですか。",
          "opciones": [
            "先生",
            "会社員",
            "医者",
            "学生"
          ],
          "respuesta": "会社員"
        },
        {
          "pregunta": "田中さんは週末何をしますか。",
          "opciones": [
            "仕事をする",
            "映画を見たり料理をしたりする",
            "旅行に行く",
            "何もしない"
          ],
          "respuesta": "映画を見たり料理をしたりする"
        },
        {
          "pregunta": "田中さんは将来何になりたいですか。",
          "opciones": [
            "医者",
            "会社員",
            "日本語の先生",
            "料理人"
          ],
          "respuesta": "日本語の先生"
        }
      ]
    },
    {
      "id": "para_04",
      "texto": "私は猫が好きです。でも、犬はあまり好きじゃないです。今、猫を二匹飼っています。一匹は白くて、もう一匹は黒いです。毎日、猫と遊んでから、仕事に行きます。猫がいるので、毎日楽しいです。",
      "preguntas": [
        {
          "pregunta": "猫は何匹いますか。",
          "opciones": [
            "一匹",
            "二匹",
            "三匹",
            "四匹"
          ],
          "respuesta": "二匹"
        },
        {
          "pregunta": "猫の色は何ですか。",
          "opciones": [
            "白と黒",
            "赤と青",
            "茶色",
            "全部白"
          ],
          "respuesta": "白と黒"
        },
        {
          "pregunta": "仕事に行く前に何をしますか。",
          "opciones": [
            "朝ご飯を食べる",
            "猫と遊ぶ",
            "勉強する",
            "本を読む"
          ],
          "respuesta": "猫と遊ぶ"
        }
      ]
    }
