  "lectura_parrafo": [
    {
      "id": "para_01",
      "texto": "私は毎日7時に起きます。朝ご飯を食べて、会社へ行きます。仕事は9時から始まります。私は会社員です。仕事はあまり難しくないですが、時々忙しいです。今日はあまり忙しくないので、早く帰ることができます。",
      "preguntas": [
        {
          "pregunta": "何時に起きますか。",
          "opciones": [
            "6時",
            "7時",
            "8時",
            "9時"
          ],
          "respuesta": "7時"
        },
        {
          "pregunta": "仕事は何時から始まりますか。",
          "opciones": [
            "7時",
            "8時",
            "9時",
            "10時"
          ],
          "respuesta": "9時"
        },
        {
